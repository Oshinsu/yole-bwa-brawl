{
  "name": "yole-bwa-brawl-threejs-tropical-mayhem-v3-2",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first Three.js tropical yole combat racer with forward/lateral boosts, coconut artillery, harpoon slingshots, concentric tsunami mines, deterministic hull physics and reactive ocean.",
  "scripts": {
    "vendor": "python3 fetch_three.py",
    "vendor:node": "node tools/vendor-three.mjs",
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "syntax": "node tools/check-syntax.mjs && python3 tools/pycheck.py",
    "build:single": "python3 tools/build_single_file.py",
    "assets:bake": "python3 tools/bake_yole_glb.py",
    "assets:bake:crew": "python3 tools/bake_crew_rig_glb.py",
    "assets:inspect": "python3 tools/inspect_glb.py",
    "assets:fit": "python3 tools/fit_hull_glb.py",
    "assets:shrink": "python3 tools/shrink_glb_textures.py",
    "verify:static": "python3 tools/verify_static.py",
    "render:tiers": "python3 tools/check_render_tiers.py",
    "render:exposure": "python3 tools/sweep_exposure.py",
    "render:bloom-ab": "python3 tools/capture_bloom_ab.py",
    "test:sim": "node test/simulation.test.mjs",
    "test:handling": "node test/handling-feel.test.mjs",
    "test:handling-feedback": "node test/handling-feedback.test.mjs",
    "test:handling-render": "node test/handling-render-feedback.test.mjs",
    "test:wake": "node test/wake.test.mjs",
    "test:game": "node test/full-game-smoke.mjs",
    "test:crew": "node test/crew-seating.test.mjs",
    "test:framerate": "node test/framerate.test.mjs",
    "benchmark": "node test/benchmark.mjs",
    "verify": "npm run syntax && npm run stamp && npm run build:single && npm run verify:static && npm run test:sim && npm run test:handling && npm run test:handling-feedback && npm run test:handling-render && npm run test:wake && npm run test:advanced && npm run test:combat && npm run test:juice && npm run test:services && npm run test:replay && npm run test:input && npm run test:ui && npm run test:versus && npm run test:ai && npm run test:quality && npm run test:pwason && npm run test:lanbi && npm run test:game && npm run test:crew && npm run test:framerate && npm run test:shader && npm run test:browser && npm run benchmark",
    "test": "npm run verify",
    "test:advanced": "node test/advanced-systems.test.mjs",
    "test:combat": "node test/combat-feedback.test.mjs",
    "test:juice": "node test/impact-juice.test.mjs",
    "test:replay": "node test/replay.test.mjs",
    "test:input": "node test/input-pause.test.mjs",
    "test:ui": "node test/ui-microinteractions.test.mjs",
    "test:versus": "node test/versus-mode.test.mjs",
    "shader:generate": "node test/generate-shader-smoke.mjs",
    "test:shader": "npm run shader:generate && python3 test/egl-shader-smoke.py",
    "test:browser": "python3 test/browser-smoke.py",
    "test:services": "node test/runtime-services.test.mjs",
    "release": "python3 tools/release.py",
    "test:ai": "node test/ai-difficulty.test.mjs",
    "check:gameplay": "python3 tools/check_gameplay.py",
    "playtest": "python3 tools/playtest_probe.py",
    "playtest:ab": "python3 tools/ab_gameplay.py",
    "check:blast": "python3 tools/check_blast_water.py",
    "check:aim": "python3 tools/check_aim.py",
    "zik:analyse": "python3 tools/analyse_zik.py",
    "check:zik": "python3 tools/check_zik.py",
    "check:polices": "python3 tools/check_polices.py",
    "test:quality": "node test/quality-warmup.test.mjs",
    "check:demarrage": "python3 tools/check_demarrage.py",
    "test:pwason": "node test/pwason-torpille.test.mjs",
    "serve:prod": "node tools/server.mjs",
    "start": "node tools/server.mjs",
    "stamp": "python3 tools/stamp_version.py",
    "check:sw": "python3 tools/stamp_version.py --verifier",
    "deploy:railway": "npm run stamp && npm run verify && railway up",
    "test:lanbi": "node test/lanbi-controle.test.mjs"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
